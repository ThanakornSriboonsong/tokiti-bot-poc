# Copy to .env. Never commit .env.
OPENROUTER_API_KEY=
# Pick from the live catalog after running the model shortlist. Must support tools, JSON schema and images.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=

# sample = editable data in this POC. tokiti stays disabled until Kin approves the read-only endpoint.
STOCK_PROVIDER=sample
TOKITI_STOCK_URL=
TOKITI_STOCK_KEY=

PORT=8787
